# Supabase — game leaderboards. Copy to .env.local and fill in from your project
# (Project Settings → API). Both are safe to expose to the browser.
# Leaderboards stay disabled (and the games work unchanged) until these are set.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
